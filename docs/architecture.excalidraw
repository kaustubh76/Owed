      "locked": false,
      "type": "text",
      "x": 253.32000000000005,
      "y": 2383.125,
      "width": 633.3599999999999,
      "height": 65,
      "text": "Never speak about a Suspected verdict — speaking unasked is the last place to guess.\nNever raise a promise already filed. The household knows.\nA host that has just come up does not read out the backlog.\nAnnouncements go stale after three days, and are dropped rather than queued.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Never speak about a Suspected verdict — speaking unasked is the last place to guess.\nNever raise a promise already filed. The household knows.\nA host that has just come up does not read out the backlog.\nAnnouncements go stale after three days, and are dropped rather than queued.",
      "lineHeight": 1.25,
      "autoResize": true
    },
