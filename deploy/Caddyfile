# Owed, behind Caddy on one box.
#
# Caddy is the only way in. The three Node processes keep listening on 127.0.0.1 exactly as
# they do under `pnpm demo` — nothing binds a public interface — so this file is the entire
# public surface of the deployment.
#
# Three, not the four `pnpm demo` runs: the fourth is the Vite dev server, and in a
# deployment the home is not a process at all. It is static files, served from disk by the
# last block in this file.
#
# Replace owed.example.com with the real hostname, and set it as OWED_ALLOWED_HOSTS and as
# the host of OWED_BASE_URL. Caddy obtains and renews the certificate itself.

owed.example.com {
	encode zstd gzip

	# ── Not proxied, on purpose ────────────────────────────────────────────────────────
	#
	# /control/* is the simulated home's own controls and the stand-in for the proactive
	# channel Alexa+ does not have. They are reached only by the brain, over loopback, on
	# the same box — the browser talks to the brain and never to these.
	#
	# Left exposed they would be three ledger leaks and an unauthenticated write:
	# /control/recourse returns the verbatim merchant negotiations, /control/commitments
	# names merchants and amounts, and POST /control/clock moves scenario time for
	# everyone at once.
	#
	# This block is the control that makes them unreachable. OWED_CONTROL_TOKEN is the
	# second line, for the day somebody edits this file — do not rely on either alone.
	handle /control/* {
		respond 404
	}

	# /health is internal too, and for a sharper reason than privacy.
	#
	# Without this block it falls through to the static site at the bottom of this file and
	# returns **index.html with a 200** — so a monitor pointed at the public /health reports
	# healthy forever, whatever the ledger is doing. A 404 is a useless answer; a 200 that
	# means nothing is a dangerous one.
	#
	# It also carries the household's event count and replays the ledger on every call,
	# neither of which belongs on a public URL.
	handle /health {
		respond 404
	}

	# ── The add-on contract ────────────────────────────────────────────────────────────
	#
	# Streamable HTTP holds long-lived text/event-stream sessions, so buffering must stay
	# off. Caddy streams by default; flush_interval -1 says so explicitly rather than
	# leaving it to a default somebody might change.
	handle /mcp* {
		reverse_proxy 127.0.0.1:3939 {
			flush_interval -1
		}
	}

	# No active health check here, and that is a reversal worth recording.
	#
	# An earlier version of this file probed /health on this upstream, on the reasoning that
	# "listening" and "able to read the ledger" are different states. Running it proved the
	# idea actively harmful: Caddy's health checker sends `Host: <upstream-address>`, the
	# server's DNS-rebinding protection answers **403** to any host outside its allow-list,
	# and Caddy then marks the only upstream unhealthy and returns `no upstreams available`
	# — a bare 503 — for every MCP request. A healthy server, taken off the air by its own
	# monitoring.
	#
	# With `127.0.0.1` as the upstream it happens to pass, because loopback is always in the
	# allow-list. That is a coincidence, not a design: anyone who moves the upstream to a
	# hostname gets a total outage whose cause is in neither service's obvious logs.
	#
	# And the check bought little even working. There is one upstream, so Caddy cannot route
	# around a bad one; and the application already answers a failed ledger read with a 503
	# that *names the reason*, which is strictly more useful than Caddy's empty one. An
	# operator curls /health on the box; see deploy/README.md.

	# OAuth discovery: RFC 9728 protected-resource and RFC 8414 authorization-server
	# metadata, plus the authorize/token endpoints. The issuer in those documents comes
	# from OWED_BASE_URL, so it must be the https origin above.
	handle /.well-known/* {
		reverse_proxy 127.0.0.1:3939
	}

	handle /oauth/* {
		reverse_proxy 127.0.0.1:3939
	}

	# ── The household UI ───────────────────────────────────────────────────────────────
	#
	# The brain's WebSocket. Caddy upgrades transparently, which is most of why this is a
	# VM behind Caddy rather than Lambda behind API Gateway.
	handle /brain* {
		reverse_proxy 127.0.0.1:3940
	}

	# Everything else is the Vite-built home. Served from disk rather than proxied to the
	# dev server: `pnpm --filter @owed/home build` output, copied here.
	handle {
		root * /srv/owed/apps/home/site
		try_files {path} /index.html
		file_server
	}
}
