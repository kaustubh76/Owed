      "type": "text",
      "x": 2833.08,
      "y": 1374.875,
      "width": 433.84,
      "height": 21.25,
      "text": "Four verdicts, in the order they are decided",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Four verdicts, in the order they are decided",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "owed-003k",
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "owed-0033",
      "roundness": null,
      "seed": 1276544,
      "version": 1,
      "versionNonce": 1013632,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 2725.78,
      "y": 1404.125,
      "width": 648.4399999999999,
      "height": 65,
      "text": "1. Kept — short-circuits first, never blocked by a gate\n2. Undetermined — too early to say, the window has not closed\n3. Breached — only when BOTH gates are met. This is the only one that can be claimed.\n4. Suspected — past the deadline but under the gate. Says what it saw, claims nothing.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Kept — short-circuits first, never blocked by a gate\n2. Undetermined — too early to say, the window has not closed\n3. Breached — only when BOTH gates are met. This is the only one that can be claimed.\n4. Suspected — past the deadline but under the gate. Says what it saw, claims nothing.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
