    },
    {
      "id": "owed-0032",
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "owed-002m",
      "roundness": null,
      "seed": 1097030,
      "version": 1,
      "versionNonce": 871090,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1508.4,
      "y": 1431,
      "width": 603.1999999999999,
      "height": 81.25,
      "text": "promise_id is optional on the schema, and the engine used to admit anything that\nomitted it — so one untagged doorbell event was visible to every promise in the\nhouse, and could clear a claim it was never about. That is the silent failure:\nmoney the household is owed and never hears about. Now tightened, and tested\nin both directions.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "promise_id is optional on the schema, and the engine used to admit anything that\nomitted it — so one untagged doorbell event was visible to every promise in the\nhouse, and could clear a claim it was never about. That is the silent failure:\nmoney the household is owed and never hears about. Now tightened, and tested\nin both directions.",
      "lineHeight": 1.25,
      "autoResize": true
    },
