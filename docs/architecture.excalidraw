      "seed": 2313736,
      "version": 1,
      "versionNonce": 1837208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1482.01,
      "y": 3391.875,
      "width": 655.9799999999999,
      "height": 97.5,
      "text": "Those merchants behave exactly as configured. Let their acceptance thresholds wobble\nby 10% and the advantage inverts — 1.10× becomes 0.95×, and 0.90× at 25%.\nArguing loses to taking the first offer once a merchant is unpredictable.\nWe then measured the obvious fix — concede a little — and it does not rescue it either.\nPublished rather than buried, because a number measured only where it flatters you\nis not a measurement.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Those merchants behave exactly as configured. Let their acceptance thresholds wobble\nby 10% and the advantage inverts — 1.10× becomes 0.95×, and 0.90× at 25%.\nArguing loses to taking the first offer once a merchant is unpredictable.\nWe then measured the obvious fix — concede a little — and it does not rescue it either.\nPublished rather than buried, because a number measured only where it flatters you\nis not a measurement.",
      "lineHeight": 1.25,
      "autoResize": true
    },
