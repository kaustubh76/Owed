      "type": "text",
      "x": 260.86,
      "y": 3194.375,
      "width": 618.28,
      "height": 32.5,
      "text": "Money a merchant agreed to is not money that arrived. Only Recovered counts toward\n\"recovered this week\" — which is why Settled is not a terminal status.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Money a merchant agreed to is not money that arrived. Only Recovered counts toward\n\"recovered this week\" — which is why Settled is not a terminal status.",
      "lineHeight": 1.25,
      "autoResize": true
    },
