      "type": "text",
      "x": 1622.66,
      "y": 1249.875,
      "width": 374.67999999999995,
      "height": 21.25,
      "text": "Why uptime is kept apart from evidence",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why uptime is kept apart from evidence",
