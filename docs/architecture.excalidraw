      "type": "text",
      "x": 2737.09,
      "y": 2997.875,
      "width": 625.8199999999999,
      "height": 97.5,
      "text": "ledger_summary      what am I owed            → ui://owed/ledger\npromises_list       list promises             → ui://owed/ledger\npromise_check       check a promise           → ui://owed/evidence\nevidence_get        get one piece of evidence → ui://owed/evidence\nclaim_status        check a claim             → ui://owed/claim\nclaim_file          file a claim              → ui://owed/claim   (the only writer)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ledger_summary      what am I owed            → ui://owed/ledger\npromises_list       list promises             → ui://owed/ledger\npromise_check       check a promise           → ui://owed/evidence\nevidence_get        get one piece of evidence → ui://owed/evidence\nclaim_status        check a claim             → ui://owed/claim\nclaim_file          file a claim              → ui://owed/claim   (the only writer)",
      "lineHeight": 1.25,
