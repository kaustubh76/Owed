      "y": 3362.625,
      "width": 384.53999999999996,
      "height": 21.25,
      "text": "And the result that does not flatter us",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "And the result that does not flatter us",
