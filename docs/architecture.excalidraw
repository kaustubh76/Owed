    {
      "id": "owed-002l",
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "owed-001o",
      "roundness": null,
      "seed": 927489,
      "version": 1,
      "versionNonce": 736467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 264.63,
      "y": 1456,
      "width": 610.74,
      "height": 81.25,
      "text": "The extractor emits exactly three confidences: 0.95 when the cue sits next to\nthe time it qualifies, 0.82 when it is further away, and 0.80 when the promise is\ninferred from a guarantee rather than stated. Over the 120-message corpus that\nis 89 reads above the line and 11 below it. One sentence can produce both.\nEvery promise carries source_quote — the merchant's own words — into the ledger.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The extractor emits exactly three confidences: 0.95 when the cue sits next to\nthe time it qualifies, 0.82 when it is further away, and 0.80 when the promise is\ninferred from a guarantee rather than stated. Over the 120-message corpus that\nis 89 reads above the line and 11 below it. One sentence can produce both.\nEvery promise carries source_quote — the merchant's own words — into the ledger.",
      "lineHeight": 1.25,
      "autoResize": true
    },
