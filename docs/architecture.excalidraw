      "width": 610.74,
      "height": 48.75,
      "text": "phantom_delivery  (delivery_window)        no_show  (appointment_slot + window)\nmissed_window  (delivery_window | appointment_slot)    late_eta  (eta + deadline)\nlate_refund  (refund_sla + deadline)        price_drop  (price_match + window)",
