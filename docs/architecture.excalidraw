      "type": "text",
      "x": 268.40000000000003,
      "y": 1972.375,
      "width": 603.1999999999999,
      "height": 32.5,
      "text": "A tool runs because somebody said something. We found no documented way for an\nadd-on to raise anything on its own — and we checked the docs, not the platform.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A tool runs because somebody said something. We found no documented way for an\nadd-on to raise anything on its own — and we checked the docs, not the platform.",
      "lineHeight": 1.25,
      "autoResize": true
    },
