      "autoResize": true
    },
    {
      "id": "owed-002y",
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "owed-002m",
      "roundness": null,
      "seed": 1057138,
      "version": 1,
      "versionNonce": 839414,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1508.4,
      "y": 1279.125,
      "width": 603.1999999999999,
      "height": 65,
      "text": "Separating what the camera was *up for* from what it *saw* is what lets Owed say\nthe door was watched and recorded nobody arriving — which is the entire\nphantom-delivery signal. It is also where coverage comes from:\ncoverage = the watched stretches ÷ the window being judged.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Separating what the camera was *up for* from what it *saw* is what lets Owed say\nthe door was watched and recorded nobody arriving — which is the entire\nphantom-delivery signal. It is also where coverage comes from:\ncoverage = the watched stretches ÷ the window being judged.",
      "lineHeight": 1.25,
      "autoResize": true
    },
