      "versionNonce": 1916398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 2752.17,
      "y": 3166.125,
      "width": 595.66,
      "height": 65,
      "text": "PKCE S256 as a hard requirement · RFC 9728 and 8414 discovery\nRFC 8707 audience binding · RFC 8252 loopback redirects\nNo dynamic client registration, deliberately: Alexa+ does not support RFC 7591,\nand advertising it would promise a capability we do not honour.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PKCE S256 as a hard requirement · RFC 9728 and 8414 discovery\nRFC 8707 audience binding · RFC 8252 loopback redirects\nNo dynamic client registration, deliberately: Alexa+ does not support RFC 7591,\nand advertising it would promise a capability we do not honour.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "owed-006r",
      "angle": 0,
      "strokeColor": "#e03131",
