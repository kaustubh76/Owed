[Unit]
# Shipped because Caddy is installed as a static binary rather than from a repo, so there
# is no packaged unit. Modelled on Caddy's own.
Description=Caddy (TLS and the only public listener)
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
# This unit had no restart policy at all, which is the worst place in the deployment to
# lack one: Caddy is the *only* public listener, so if it died the box went dark for good
# while the three services behind it restarted forever in a loop nobody could reach. The
# upstream unit this is modelled on carries `on-abnormal`, and so does this now — not
# `always`, because a clean exit here means a deliberate stop.
Restart=on-abnormal
RestartSec=2s
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
# Needed to bind 80 and 443 as a non-root user, and nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
