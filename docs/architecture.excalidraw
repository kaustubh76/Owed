      "type": "text",
      "x": 2640.81,
      "y": 1528.25,
      "width": 818.38,
      "height": 21.25,
      "text": "The loudest verdict wins:  Breached 3  >  Suspected 2  >  Kept 1  >  Undetermined 0",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The loudest verdict wins:  Breached 3  >  Suspected 2  >  Kept 1  >  Undetermined 0",
